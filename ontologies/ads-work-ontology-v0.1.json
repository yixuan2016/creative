  "mapping_rules": [
    {
      "rule_id": "MAP-001",
      "source_pattern": "源系统字段与 ADS Core 概念存在经批准的一对一映射",
      "target_concept": "对应 core.* 概念或字段",
      "method": "exact",
      "review_required": false,
      "guardrails": [
        "保留源系统和原生 ID。",
        "映射版本必须可追溯。"
      ]
    },
    {
      "rule_id": "MAP-002",
      "source_pattern": "系统枚举、别名或历史术语",
      "target_concept": "ADS Core 或 Enterprise 规范术语",
      "method": "dictionary",
      "review_required": true,
      "guardrails": [
        "词面相似不等于语义等价。",
        "未知值保留原值并标记 unresolved。"
      ]
    },
    {
      "rule_id": "MAP-003",
      "source_pattern": "非结构化文本、会议转写或个人观察",
      "target_concept": "候选 Event、Task、Commitment 或 Decision",
      "method": "model_assisted",
      "review_required": true,
      "guardrails": [
        "抽取结果先标记 observed 或 inferred。",
        "不得自动把建议、讨论或意向升级为正式任务或决策。"
      ]
    },
    {
      "rule_id": "MAP-004",
      "source_pattern": "个人侧工作事件提交到企业业务范围",
      "target_concept": "enterprise.WorkEvent 与企业 BusinessObject",
      "method": "projection",
      "review_required": true,
      "guardrails": [
        "目的、租户、对象、字段、接收者和有效期必须明确。",
        "生成新的企业事件 ID。",
        "不复制个人原始内容和无关生活信息。"
      ]
    },
    {
      "rule_id": "MAP-005",
      "source_pattern": "两个或多个业务系统的对象身份候选",
      "target_concept": "core.BusinessObject identity mapping",
      "method": "rule_based",
      "review_required": true,
      "guardrails": [
        "不得只凭名称或向量相似度合并对象。",
        "无法唯一确认时保留 candidate 或 unresolved。"
      ]
    },
    {
      "rule_id": "MAP-006",
      "source_pattern": "领域专有术语或本地业务字段",
      "target_concept": "ads.domain.* 或 ads.local.*",
      "method": "human_curated",
      "review_required": true,
      "guardrails": [
        "指定领域 Owner。",
        "声明父概念、范围、映射和兼容策略。",
        "不得静默重定义 ADS Core。"
      ]
    },
    {
      "rule_id": "MAP-007",
      "source_pattern": "多来源对同一状态给出不一致结果",
      "target_concept": "core.StateAssertion 与 core.contradicts",
      "method": "rule_based",
      "review_required": true,
      "guardrails": [
        "保留所有来源和有效时间。",
        "不以多数票或模型置信度覆盖权威来源。"
      ]
    }
  ],
  "governance": {
    "default_personal_scope": "personal_only",
    "enterprise_projection": [
      "必须有明确业务目的、目标租户和接收责任方。",
      "必须限定目标对象、字段、动作和有效期。",
      "必须具备有效授权和适用组织策略依据。",
      "高影响任务、决策、责任和状态需人工确认。",
      "个人侧记录与企业侧投影使用不同 ID 和生命周期。",
      "企业侧不得通过派生引用反向读取个人原始记录。"
    ],
    "cross_tenant_policy": "跨租户实例数据默认禁止互通；跨域协作仅通过联邦目录、共同语义和任务级授权交换最小必要数据。",
    "revocation_behavior": [
      "撤回后立即停止新的读取、投影和下游调用。",
      "登记撤回时间、授权版本和受影响的派生记录。",
      "按数据责任、法律和组织制度判断删除、限制、替换或保留审计。",
      "能力资产若由多来源抽象形成，应重新评估来源授权和可保留性。"
    ],
    "provenance_requirements": [
      "关键事件保留来源系统、原生记录 ID、版本和定位。",
      "记录抽取模型或规则版本、映射版本和人工修正。",
      "状态断言保留来源、有效时间、断言状态和核验主体。",
      "派生事件保留受控 lineage token，不暴露个人原始事件 ID。"
    ],
    "retention_policy": "按数据类别、目的、来源系统、组织制度和适用法律设定保留期；不得以本体注册为由无限期保留实例数据。",
    "human_review_triggers": [
      "对象身份存在多个候选或高影响关系。",
      "推断将改变正式任务、承诺、决策、风险或验收状态。",
      "个人事件拟投影到企业。",
      "跨领域映射存在语义损失或冲突。",
      "授权、分类、来源或证据状态不完整。"
    ]
  },
