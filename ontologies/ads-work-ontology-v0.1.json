{
  "ontology_id": "ads.work-ontology",
  "version": "0.1.0",
  "status": "candidate",
  "purpose": "为个人工作与生活上下文、企业工作运行和业务领域协同提供可版本化的共同语义、概念目录、事件类型、关系谓词和映射规则。",
  "scope_model": {
    "personal": {
      "description": "个人数智底座中的个人工作、生活、学习、目标和资源上下文。",
      "instance_data_policy": "个人实例默认 personal_only，由个人控制；用户可对特定事件、字段、目的和接收方单独授权。",
      "semantic_definition_policy": "个人可扩展本地概念和别名；共享语义定义不意味着共享个人实例数据。"
    },
    "enterprise": {
      "description": "企业数智底座中的业务对象、工作事件、流程、任务、决策、风险、证据和能力资产。",
      "instance_data_policy": "由企业业务责任方按业务目的、制度、权限和数据分类管理；权威状态引用权威业务系统。",
      "semantic_definition_policy": "企业可以扩展企业命名空间，但不得静默改变 ADS Core 的定义。"
    },
    "domain_federated": {
      "description": "业务领域中心维护共同语义、领域概念、映射规则、版本和联邦目录。",
      "instance_data_policy": "默认维护语义元数据、映射和目录，不集中存储个人或企业原始事件；跨域实例交换须任务级授权。",
      "semantic_definition_policy": "领域 Owner 负责领域本体；跨领域映射必须记录等价程度、损失和责任人。"
    },
    "shared_core": {
      "description": "ADS 共同核心概念与稳定关系，为个人、企业和领域本体提供语义锚点。",
      "instance_data_policy": "共享的是概念定义和标识，不自动共享任何实例、内容或证据。",
      "semantic_definition_policy": "核心概念由 ADS 架构治理流程评审、版本化和发布。"
    },
    "projection_policy": [
      "个人事件默认不投影到企业。",
      "投影必须绑定明确目的、目标租户、目标对象、字段、接收者、有效期和授权引用。",
      "个人侧记录与企业侧投影使用不同 ID 和生命周期。",
      "投影只生成最小必要的新企业记录，不复制个人原始音频、完整笔记或无关生活信息。",
      "企业侧不得通过投影引用反向读取个人原始事件。"
    ]
  },
  "layers": [
    {
      "layer_id": "L1",
      "name": "信号与观察层 Signal & Observation",
      "purpose": "记录系统观察到的原始来源、模态、采集会话和解析结果；不直接将观察等同于业务事实。",
      "concepts": [
        "core.SourceRecord",
        "core.Observation",
        "core.CaptureSession",
        "core.ExtractionRun"
      ]
    },
    {
      "layer_id": "L2",
      "name": "事件与活动层 Event & Activity",
      "purpose": "表达事件、活动、任务、承诺、交互和结果，形成工作与生活过程的时间序列。",
      "concepts": [
        "core.Event",
        "core.Activity",
        "core.Task",
        "core.Commitment",
        "core.Decision",
        "personal.PersonalContextEvent",
        "personal.WorkEvent",
        "personal.LifeEvent",
        "enterprise.WorkEvent"
      ]
    },
    {
      "layer_id": "L3",
      "name": "语义对象与状态层 Semantic Object & State",
      "purpose": "关联行动主体、组织、项目、客户、产品、个人对象、关系、身份映射和状态断言。",
      "concepts": [
        "core.Actor",
        "core.BusinessObject",
        "core.StateAssertion",
        "core.Relation",
        "enterprise.Project",
        "enterprise.Customer",
        "enterprise.Product"
      ]
    },
    {
      "layer_id": "L4",
      "name": "上下文与决策层 Context & Decision",
      "purpose": "围绕任务和业务对象组织目标、约束、决策、风险、依赖、证据、冲突和未知。",
      "concepts": [
        "core.ContextPackage",
        "core.Goal",
        "core.Constraint",
        "core.Evidence",
        "enterprise.Risk",
        "enterprise.Milestone"
      ]
    },
    {
      "layer_id": "L5",
      "name": "能力与执行层 Capability & Execution",
      "purpose": "将经过验证的任务方法连接到能力资产、Agent、工具、审批、运行和反馈。",
      "concepts": [
        "capability.CapabilityAsset",
        "runtime.AgentRun",
        "core.AuthorizationGrant"
      ]
    }
  ],
  "classes": [
    {
      "class_id": "core.Actor",
      "namespace": "core",
      "label": "行动主体",
      "parent_class": null,
      "definition": "执行、参与、发起或承担责任的人、角色、Agent 或系统。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "按主体类型、责任域和稳定标识解析；人员跨组织角色不得混为同一权限身份。"
    },
    {
      "class_id": "core.Event",
      "namespace": "core",
      "label": "事件",
      "parent_class": null,
      "definition": "在某个时间或时间区间内发生的变化或可被观察的事实候选。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "每条事件有独立 ID，并保留来源、时间、类型和生命周期。"
    },
    {
      "class_id": "core.Activity",
      "namespace": "core",
      "label": "活动",
      "parent_class": null,
      "definition": "为实现目标而持续进行的一组行动，可包含多个事件和任务。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "活动按主体、目标和时间范围建立实例身份。"
    },
    {
      "class_id": "core.Task",
      "namespace": "core",
      "label": "任务",
      "parent_class": null,
      "definition": "具有预期结果、责任主体、状态和完成条件的工作单元。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "任务实例由其责任边界内的任务系统或任务 Owner 管理。"
    },
    {
      "class_id": "core.Commitment",
      "namespace": "core",
      "label": "承诺",
      "parent_class": null,
      "definition": "主体对未来行动或结果作出的承诺，需区分表达、确认和履约状态。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "必须记录承诺主体、对象、时间和确认状态。"
    },
    {
      "class_id": "core.Decision",
      "namespace": "core",
      "label": "决策",
      "parent_class": "core.Event",
      "definition": "在约束和备选方案下作出的选择，具有决策主体、权限、生效范围和依据。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "confidential",
      "identity_policy": "正式决策必须关联有权主体和审批或确认依据。"
    },
    {
      "class_id": "core.BusinessObject",
      "namespace": "core",
      "label": "业务对象",
      "parent_class": null,
      "definition": "在某一责任域中被管理、引用或发生状态变化的对象。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "使用命名空间、租户和源系统标识；名称相同不代表身份相同。"
    },
    {
      "class_id": "core.StateAssertion",
      "namespace": "core",
      "label": "状态断言",
      "parent_class": null,
      "definition": "对对象属性或状态在特定有效时间内的有来源描述。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "每条断言独立标识，保留来源、有效时间和断言状态。"
    },
    {
      "class_id": "core.Relation",
      "namespace": "core",
      "label": "关系",
      "parent_class": null,
      "definition": "两个概念实例之间有类型、方向、时间和来源的语义关系。",
      "instance_scopes": [
        "personal",
        "enterprise",
        "domain_federated"
      ],
      "default_classification": "internal",
      "identity_policy": "关系实例独立标识；关系谓词由本体版本定义。"
    },
    {
      "class_id": "core.Evidence",
      "namespace": "core",
      "label": "证据",
      "parent_class": null,
      "definition": "支持、限定或反驳某项断言的来源引用及定位信息。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "confidential",
      "identity_policy": "保留源系统、原生记录 ID、版本、定位和核验状态。"
    },
    {
      "class_id": "core.SourceRecord",
      "namespace": "core",
      "label": "来源记录",
      "parent_class": null,
      "definition": "原始消息、文件、会议、系统记录或其他信息来源的受控引用。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "confidential",
      "identity_policy": "保留来源命名空间和原生 ID，不以摘要替代原始来源身份。"
    },
    {
      "class_id": "core.ContextPackage",
      "namespace": "core",
      "label": "上下文包",
      "parent_class": null,
      "definition": "在明确任务、目的、范围和授权下组织的最小必要上下文视图。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "confidential",
      "identity_policy": "按任务、请求主体、策略版本和有效期建立独立身份。"
    },
    {
      "class_id": "core.AuthorizationGrant",
      "namespace": "core",
      "label": "授权凭据",
      "parent_class": null,
      "definition": "限定主体、目的、范围、字段、动作和有效期的授权记录引用。",
      "instance_scopes": [
        "personal",
        "enterprise",
        "domain_federated"
      ],
      "default_classification": "restricted",
      "identity_policy": "授权由有权主体或策略服务签发、撤回和审计。"
    },
    {
      "class_id": "core.Goal",
      "namespace": "core",
      "label": "目标",
      "parent_class": null,
      "definition": "主体或组织希望在明确范围和时间内达到的预期状态。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "按目标主体、时间范围和目标版本标识。"
    },
    {
      "class_id": "core.Constraint",
      "namespace": "core",
      "label": "约束",
      "parent_class": null,
      "definition": "影响任务或决策的时间、资源、权限、质量或业务规则限制。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "关联来源、适用范围和有效时间。"
    },
    {
      "class_id": "core.Observation",
      "namespace": "core",
      "label": "观察记录",
      "parent_class": null,
      "definition": "系统或主体对某个来源信号的观测、抽取或解释结果。",
      "instance_scopes": [
        "personal",
        "enterprise"
      ],
      "default_classification": "confidential",
      "identity_policy": "绑定来源记录、处理版本和观察时间。"
    },
    {
      "class_id": "personal.PersonalContextEvent",
      "namespace": "personal",
      "label": "个人上下文事件",
      "parent_class": "core.Event",
      "definition": "由个人数智底座管理、用于个人理解和记忆的事件。",
      "instance_scopes": [
        "personal"
      ],
      "default_classification": "personal",
      "identity_policy": "由个人主体控制，默认 personal_only。"
    },
    {
      "class_id": "personal.WorkEvent",
      "namespace": "personal",
      "label": "个人工作事件",
      "parent_class": "personal.PersonalContextEvent",
      "definition": "个人对自身工作活动、任务、协作、承诺和判断的记录，不自动构成企业正式记录。",
      "instance_scopes": [
        "personal"
      ],
      "default_classification": "personal",
      "identity_policy": "个人侧独立 ID；投影到企业时生成新的企业事件 ID。"
    },
    {
      "class_id": "personal.LifeEvent",
      "namespace": "personal",
      "label": "个人生活事件",
      "parent_class": "personal.PersonalContextEvent",
      "definition": "个人生活安排、承诺、活动和目标等上下文事件。",
      "instance_scopes": [
        "personal"
      ],
      "default_classification": "personal_sensitive",
      "identity_policy": "默认个人私有；不得因员工身份自动进入企业侧。"
    },
    {
      "class_id": "personal.LearningEvent",
      "namespace": "personal",
      "label": "个人学习事件",
      "parent_class": "personal.PersonalContextEvent",
      "definition": "个人学习、反思、成长和技能进展相关事件。",
      "instance_scopes": [
        "personal"
      ],
      "default_classification": "personal",
      "identity_policy": "由个人控制；对外分享须单独选择目的和范围。"
    },
    {
      "class_id": "enterprise.WorkEvent",
      "namespace": "enterprise",
      "label": "企业工作事件",
      "parent_class": "core.Event",
      "definition": "在企业业务责任边界内接收、确认或记录的标准工作事件。",
      "instance_scopes": [
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "企业侧独立 ID，关联企业租户、业务对象、来源和授权。"
    },
    {
      "class_id": "enterprise.Project",
      "namespace": "enterprise",
      "label": "项目",
      "parent_class": "core.BusinessObject",
      "definition": "具有目标、范围、组织责任、计划和交付结果的企业业务对象。",
      "instance_scopes": [
        "enterprise"
      ],
      "default_classification": "confidential",
      "identity_policy": "以项目主数据或经确认的企业对象映射为准。"
    },
    {
      "class_id": "enterprise.Customer",
      "namespace": "enterprise",
      "label": "客户",
      "parent_class": "core.BusinessObject",
      "definition": "企业客户主数据及其受治理的业务关系对象。",
      "instance_scopes": [
        "enterprise"
      ],
      "default_classification": "confidential",
      "identity_policy": "以 CRM 或指定权威客户主数据为准。"
    },
    {
      "class_id": "enterprise.Product",
      "namespace": "enterprise",
      "label": "产品",
      "parent_class": "core.BusinessObject",
      "definition": "企业管理的产品、服务或解决方案对象。",
      "instance_scopes": [
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "以产品主数据和版本管理规则为准。"
    },
    {
      "class_id": "enterprise.OrganizationUnit",
      "namespace": "enterprise",
      "label": "组织单元",
      "parent_class": "core.BusinessObject",
      "definition": "企业内部部门、团队或组织结构节点。",
      "instance_scopes": [
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "以组织主数据和生效时间为准。"
    },
    {
      "class_id": "enterprise.Risk",
      "namespace": "enterprise",
      "label": "风险",
      "parent_class": "core.BusinessObject",
      "definition": "可能影响目标达成的候选或已确认不确定性事项。",
      "instance_scopes": [
        "enterprise"
      ],
      "default_classification": "confidential",
      "identity_policy": "候选风险和正式风险分配不同状态，正式风险由责任人确认。"
    },
    {
      "class_id": "enterprise.Milestone",
      "namespace": "enterprise",
      "label": "里程碑",
      "parent_class": "core.BusinessObject",
      "definition": "项目或流程中具有计划日期、验收条件和责任人的关键节点。",
      "instance_scopes": [
        "enterprise"
      ],
      "default_classification": "internal",
      "identity_policy": "与项目主数据和计划版本绑定。"
    },
    {
      "class_id": "domain.project_delivery.Deliverable",
      "namespace": "domain.project_delivery",
      "label": "交付物",
      "parent_class": "core.BusinessObject",
      "definition": "项目交付范围内需要提交、审查或验收的成果对象。",
      "instance_scopes": [
        "enterprise",
        "domain_federated"
      ],
      "default_classification": "confidential",
      "identity_policy": "使用项目、交付物类型、版本和源系统标识解析。"
    },
    {
      "class_id": "domain.project_delivery.Acceptance",
      "namespace": "domain.project_delivery",
      "label": "验收",
      "parent_class": "core.Event",
      "definition": "由有权责任主体依据验收条件对交付物作出的正式验收结果。",
      "instance_scopes": [
        "enterprise"
      ],
      "default_classification": "confidential",
      "identity_policy": "必须关联正式验收来源、交付物版本和授权责任人。"
    },
    {
      "class_id": "capability.CapabilityAsset",
      "namespace": "capability",
      "label": "能力资产",
      "parent_class": "core.BusinessObject",
      "definition": "经过抽象、验证、版本化和治理的可复用工作能力。",
      "instance_scopes": [
        "enterprise",
        "domain_federated"
      ],
      "default_classification": "internal",
      "identity_policy": "引用 ADS-WORK-07 Capability Manifest 的稳定 ID 和版本。"
    },
    {
      "class_id": "runtime.AgentRun",
      "namespace": "runtime",
      "label": "Agent 运行",
      "parent_class": "core.Activity",
      "definition": "Agent 在任务契约、上下文和策略约束下执行的一次运行实例。",
      "instance_scopes": [
        "enterprise"
      ],
      "default_classification": "confidential",
      "identity_policy": "绑定 trace、task、agent、capability、policy 和上下文版本。"
    }
  ],
  "relations": [
    {
      "predicate": "core.involves_actor",
      "domain": "core.Event",
      "range": "core.Actor",
      "direction": "directed",
      "temporal": true,
      "evidence_required": true,
      "scope_rule": "主体引用必须在调用主体授权范围内；个人主体与企业角色不得混淆。"
    },
    {
      "predicate": "core.about_object",
      "domain": "core.Event",
      "range": "core.BusinessObject",
      "direction": "directed",
      "temporal": true,
      "evidence_required": true,
      "scope_rule": "对象映射未确认时只能建立候选关系。"
    },
    {
      "predicate": "core.occurred_in",
      "domain": "core.Event",
      "range": "core.Activity",
      "direction": "directed",
      "temporal": true,
      "evidence_required": false,
      "scope_rule": "活动范围由事件和活动各自责任主体管理。"
    },
    {
      "predicate": "core.generated_from",
      "domain": "core.Event",
      "range": "core.SourceRecord",
      "direction": "directed",
      "temporal": false,
      "evidence_required": true,
      "scope_rule": "保留来源定位和处理版本，不以摘要替代来源。"
    },
    {
      "predicate": "core.derived_from",
      "domain": "core.Event",
      "range": "core.Event",
      "direction": "directed",
      "temporal": false,
      "evidence_required": true,
      "scope_rule": "跨责任边界派生须使用受控引用，不暴露源侧原始内容。"
    },
    {
      "predicate": "core.supports",
      "domain": "core.Evidence",
      "range": "core.StateAssertion",
      "direction": "directed",
      "temporal": true,
      "evidence_required": true,
      "scope_rule": "证据只能支持其可定位且经过适当核验的断言。"
    },
    {
      "predicate": "core.contradicts",
      "domain": "core.StateAssertion",
      "range": "core.StateAssertion",
      "direction": "directed",
      "temporal": true,
      "evidence_required": true,
      "scope_rule": "冲突断言并列保留，不以模型置信度静默覆盖。"
    },
    {
      "predicate": "core.assigned_to",
      "domain": "core.Task",
      "range": "core.Actor",
      "direction": "directed",
      "temporal": true,
      "evidence_required": true,
      "scope_rule": "正式责任分配须符合组织角色和任务系统权限。"
    },
    {
      "predicate": "core.owned_by",
