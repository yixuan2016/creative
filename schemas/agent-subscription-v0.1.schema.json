{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Subscription Request V0.1",
  "type": "object",
  "required": [
    "agent_id",
    "purpose_scopes",
    "expires_at"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "default": "ws-lab"
    },
    "agent_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "purpose_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "personal_knowledge",
          "personal_assistant",
          "project_context",
          "task_support",
          "personal_search"
        ]
      }
    },
    "event_types": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "max_sensitivity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "default": "P1"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "default": "local-user"
    }
  },
  "additionalProperties": false
}