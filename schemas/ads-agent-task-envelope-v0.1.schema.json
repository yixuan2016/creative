{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ads/schemas/ads-agent-task-envelope-v0.1.schema.json",
  "title": "ADS Agent Task Envelope",
  "description": "Versioned task contract for controlled delegation between enterprise agents. Example contract only; production policy is enforced server-side.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_id",
    "tenant_id",
    "trace_id",
    "run_id",
    "task_id",
    "task_type",
    "task_version",
    "requester",
    "recipient",
    "purpose",
    "scope",
    "context_package_ref",
    "input",
    "allowed_capabilities",
    "prohibited_actions",
    "risk_tier",
    "constraints",
    "expected_output",
    "idempotency_key",
    "policy_version",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "task_version": {
      "type": "string",
      "minLength": 1
    },
    "requester": {
      "$ref": "#/$defs/subject"
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "agent_version"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_refs"
      ],
      "properties": {
        "object_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "time_window": {
          "$ref": "#/$defs/timeWindow"
        },
        "field_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "context_package_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "integrity_hash",
        "expires_at"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "integrity_hash": {
          "type": "string",
          "pattern": "^sha256:.+"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "input": {
      "type": "object"
    },
    "allowed_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "risk_tier": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_required",
        "preserve_unknowns",
        "do_not_infer_approval",
        "max_steps",
        "max_tool_calls",
        "max_delegation_depth"
      ],
      "properties": {
        "evidence_required": {
          "type": "boolean"
        },
        "preserve_unknowns": {
          "type": "boolean"
        },
        "do_not_infer_approval": {
          "type": "boolean"
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "max_delegation_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "token_budget": {
          "type": "integer",
          "minimum": 1
        },
        "cost_budget": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "required_sections"
      ],
      "properties": {
        "schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "required_sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_format": {
          "type": "string"
        },
        "partial_result_allowed": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_type",
        "subject_id"
      ],
      "properties": {
        "subject_type": {
          "enum": [
            "user",
            "agent",
            "service",
            "system"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "on_behalf_of": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
