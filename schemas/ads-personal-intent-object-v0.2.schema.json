{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADS Personal Intent Object V0.2",
  "type": "object",
  "required": [
    "workspace_id",
    "intent_type",
    "title",
    "priority",
    "purpose_scopes"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "default": "ws-lab"
    },
    "intent_type": {
      "enum": [
        "goal",
        "commitment",
        "plan",
        "milestone",
        "task",
        "aspiration"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8000
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_intent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "start_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "sensitivity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "purpose_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "personal_knowledge",
          "personal_assistant",
          "project_context",
          "task_support",
          "personal_search"
        ]
      }
    },
    "event_ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "created_by": {
      "type": "string",
      "default": "local-user"
    }
  },
  "additionalProperties": false
}