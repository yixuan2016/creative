{
  "mapping_id": "pdks-to-ads-personal-v0.1",
  "mapping_version": "0.1.0",
  "source_standard": {
    "name": "PDKS",
    "version": "0.1.0",
    "record_types": [
      "entity",
      "source_asset",
      "evidence_segment",
      "event",
      "assertion",
      "knowledge_asset",
      "personal_context",
      "action",
      "relationship"
    ]
  },
  "target": {
    "name": "ADS-WORK-09",
    "ontology_version": "ads.work-ontology@0.1.0",
    "contracts": [
      "ads-personal-event-ledger-v0.1",
      "ads-personal-memory-item-v0.1",
      "ads-personal-intent-object-v0.1"
    ]
  },
  "policy": {
    "mode": "personal_side_projection_only",
    "preserve_object_ids": true,
    "preserve_original_payload": true,
    "default_scope": "personal_only",
    "enterprise_projection": false,
    "create_agent_action_proposals": false,
    "require_occurrence_time": true,
    "require_source_asset": true,
    "require_consent_for_device_and_connector_capture": true,
    "require_projected_source_event_for_memory_and_intent": true,
    "report_mapping_losses": true
  },
  "mappings": {
    "event": {
      "target": "Personal Event Ledger",
      "event_type_rule": "personal.{domain}.{remaining taxonomy segments joined by underscore}",
      "required": [
        "payload.start_at",
        "resolvable source_asset"
      ],
      "preserve": [
        "original event_type",
        "event_taxonomy_version",
        "source_refs",
        "evidence_refs"
      ]
    },
    "action": {
      "target": "Personal Intent Object",
      "types": {
        "task": "task",
        "commitment": "commitment",
        "plan": "task",
        "reminder": "task"
      },
      "note": "plan/reminder subtype is retained in extensions; never maps to Personal Agent Action Proposal"
    },
    "personal_context": {
      "target": "Memory Item",
      "requires": "at least one successfully projected source event",
      "inferred_status": "candidate"
    },
    "knowledge_asset": {
      "target": "Memory Item",
      "requires": "at least one successfully projected source event",
      "memory_types": {
        "method": "procedural",
        "procedure": "procedural",
        "experience": "episodic",
        "case": "episodic",
        "concept": "semantic",
        "fact": "semantic",
        "principle": "semantic",
        "lesson": "semantic",
        "insight": "semantic"
      }
    },
    "assertion": {
      "target": null,
      "policy": "preserve_only; no direct ADS-WORK-09 assertion contract"
    },
    "entity": {
      "target": "Ontology Identity Reference",
      "policy": "reference_only; no automatic master-data creation or merge"
    },
    "source_asset": {
      "target": "core.SourceRecord",
      "policy": "reference_only"
    },
    "evidence_segment": {
      "target": "core.Evidence",
      "policy": "reference_only"
    },
    "relationship": {
      "target": "Ontology Relation",
      "policy": "preserve predicate, evidence, status, confidence and validity"
    }
  },
  "capture_mode_map": {
    "manual_upload": "manual_import",
    "api_import": "manual_import",
    "system_sync": "connector_sync",
    "device_capture": "device_capture",
    "automatic": "connector_sync"
  },
  "authorization_required_modes": [
    "connector_sync",
    "device_capture"
  ],
  "classification_map": {
    "personal_private": "personal_sensitive",
    "personal_work": "personal",
    "organization_internal": "restricted",
    "restricted": "restricted",
    "public": "personal"
  },
  "non_equivalences": [
    [
      "PDKS event",
      "ADS Memory Item"
    ],
    [
      "PDKS action",
      "ADS Personal Agent Action Proposal"
    ],
    [
      "PDKS assertion",
      "verified fact"
    ],
    [
      "personal work event",
      "enterprise work event"
    ],
    [
      "shared ontology definition",
      "shared record ownership"
    ]
  ]
}