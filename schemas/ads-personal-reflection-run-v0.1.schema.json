{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADS Personal Reflection Run V0.1",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "default": "ws-lab"
    },
    "since": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 100
    },
    "created_by": {
      "type": "string",
      "default": "local-user"
    }
  },
  "additionalProperties": false
}