{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event Fusion Candidate Decision V0.1",
  "type": "object",
  "required": [
    "action",
    "reason"
  ],
  "properties": {
    "action": {
      "enum": [
        "same_occurrence",
        "distinct",
        "reject"
      ]
    },
    "actor_id": {
      "type": "string",
      "default": "local-user"
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    }
  },
  "additionalProperties": false
}