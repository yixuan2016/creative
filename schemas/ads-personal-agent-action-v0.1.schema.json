{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ads/schemas/ads-personal-agent-action-v0.1.schema.json",
  "title": "ADS Personal Agent Action Proposal",
  "description": "A bounded, auditable proposal for a personal agent action. L2/L3 actions require explicit user approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "subject_ref",
    "task_ref",
    "purpose",
    "requested_by",
    "context_package_ref",
    "action_class",
    "risk_tier",
    "plan",
    "allowed_capabilities",
    "prohibited_actions",
    "side_effects",
    "approval",
    "execution",
    "policy_version",
    "idempotency_key",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "proposal_id": {
      "type": "string"
    },
    "subject_ref": {
      "type": "string"
    },
    "task_ref": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "requested_by": {
      "enum": [
        "user",
        "agent",
        "schedule",
        "event_trigger"
      ]
    },
    "context_package_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "integrity_hash",
        "expires_at"
      ],
      "properties": {
        "context_id": {
          "type": "string"
        },
        "integrity_hash": {
          "type": "string",
          "pattern": "^sha256:.+"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "action_class": {
      "enum": [
        "read_only",
        "draft_only",
        "personal_reminder",
        "reversible_write",
        "external_communication",
        "financial_action",
        "destructive_action",
        "permission_change"
      ]
    },
    "risk_tier": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "description",
          "tool_ref",
          "side_effect_level"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tool_ref": {
            "type": "string"
          },
          "side_effect_level": {
            "enum": [
              "none",
              "local_reversible",
              "external_visible",
              "irreversible"
            ]
          }
        }
      }
    },
    "allowed_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "approved_by",
        "approved_at",
        "approval_ref",
        "approved_plan_hash"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected",
            "expired"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_plan_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "started_at",
        "finished_at",
        "verification_status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_started",
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "partial"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "verification_status": {
          "enum": [
            "not_checked",
            "verified",
            "unverified",
            "failed_verification"
          ]
        },
        "result_ref": {
          "type": "string"
        },
        "side_effect_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "description"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "policy_version": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object"
    }
  }
}
