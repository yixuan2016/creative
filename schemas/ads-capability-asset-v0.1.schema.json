{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ads.example/schemas/ads-capability-asset-v0.1.schema.json",
  "title": "ADS Capability Asset Manifest",
  "description": "Versioned manifest for a governed, evaluated, reusable enterprise capability. This contract describes an asset; runtime authorization is enforced separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "name",
    "type",
    "version",
    "domain",
    "task_family",
    "purpose",
    "owner",
    "lifecycle_status",
    "applicability",
    "non_applicability",
    "preconditions",
    "input_contract",
    "procedure",
    "evidence_requirements",
    "output_contract",
    "allowed_actions",
    "prohibited_actions",
    "evaluation_profile",
    "portability_profile",
    "provenance",
    "governance",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "type": {
      "enum": [
        "skill",
        "playbook",
        "rule",
        "workflow",
        "template",
        "tool",
        "decision_pattern",
        "evidence_standard",
        "evaluation_set",
        "ontology_pattern",
        "capability_package"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "task_family": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team",
        "role"
      ],
      "properties": {
        "team": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "owner_subject_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "lifecycle_status": {
      "enum": [
        "candidate",
        "in_review",
        "sandbox",
        "validated",
        "published",
        "suspended",
        "deprecated",
        "retired",
        "rejected"
      ]
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "non_applicability": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "required"
      ],
      "properties": {
        "schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "context_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "procedure": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "required"
      ],
      "properties": {
        "schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ontology_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evaluation_profile": {
      "type": "string",
      "minLength": 1
    },
    "portability_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validated_levels",
        "status"
      ],
      "properties": {
        "validated_levels": {
          "type": "array",
          "items": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "P4",
              "P5"
            ]
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "not_yet_validated",
            "exploratory",
            "conditional",
            "validated",
            "restricted",
            "failed"
          ]
        },
        "validated_contexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unvalidated_contexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adaptation_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "derivation_summary"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_type",
              "source_ref",
              "authorized_for_derivation",
              "transformation_summary"
            ],
            "properties": {
              "source_type": {
                "enum": [
                  "work_event",
                  "task_result",
                  "document",
                  "feedback_event",
                  "interview",
                  "workflow",
                  "synthetic_test",
                  "other"
                ]
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "authorized_for_derivation": {
                "type": "boolean"
              },
              "transformation_summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "derivation_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_classification",
        "sharing_scope",
        "privacy_review",
        "ip_review",
        "review_date"
      ],
      "properties": {
        "data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "sharing_scope": {
          "enum": [
            "personal",
            "project",
            "team",
            "enterprise",
            "domain_federated"
          ]
        },
        "privacy_review": {
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected",
            "restricted"
          ]
        },
        "ip_review": {
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected",
            "restricted"
          ]
        },
        "consent_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
