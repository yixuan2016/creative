{
  "contract_name": "PDKS Capture Result Contract",
  "contract_version": "0.2.0",
  "description": "A host-neutral contract for an agent's capture result; not a PDKS record schema replacement.",
  "required": [
    "status",
    "summary",
    "records",
    "validation"
  ],
  "properties": {
    "status": {
      "enum": [
        "drafted",
        "validated",
        "saved",
        "needs_review",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object"
    },
    "persistence_receipt": {
      "type": [
        "object",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "notes": [
    "This contract describes the result envelope returned by an agent.",
    "Each item in records must independently conform to the canonical PDKS 0.1 record schema.",
    "A null persistence_receipt means records were not confirmed as saved."
  ]
}