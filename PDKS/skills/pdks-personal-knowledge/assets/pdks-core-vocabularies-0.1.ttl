@prefix pdks: <urn:pdks:ontology:0.1#> .
@prefix pdksv: <urn:pdks:vocabulary:0.1#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pdksv:CoreVocabularies a skos:ConceptScheme ;
  skos:prefLabel "PDKS 核心受控词汇 0.1"@zh ;
  skos:notation "0.1.0" .

# Epistemic status
pdksv:EpistemicStatus a skos:Collection ;
  skos:prefLabel "认知状态"@zh ;
  skos:member pdksv:reported, pdksv:inferred, pdksv:hypothesized, pdksv:corroborated, pdksv:disputed, pdksv:retracted, pdksv:unknown .
pdksv:reported a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "来源报告"@zh ; skos:notation "reported" .
pdksv:inferred a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "系统推断"@zh ; skos:notation "inferred" .
pdksv:hypothesized a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "假设"@zh ; skos:notation "hypothesized" .
pdksv:corroborated a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "多方印证"@zh ; skos:notation "corroborated" .
pdksv:disputed a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "存在争议"@zh ; skos:notation "disputed" .
pdksv:retracted a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "已撤回"@zh ; skos:notation "retracted" .
pdksv:unknown a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "未知"@zh ; skos:notation "unknown" .

# Assertion types
pdksv:AssertionTypes a skos:Collection ;
  skos:prefLabel "表达类型"@zh ;
  skos:member pdksv:observation, pdksv:opinion, pdksv:hypothesis, pdksv:intention, pdksv:commitment, pdksv:decision, pdksv:question, pdksv:estimate, pdksv:preference .
pdksv:observation a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "观察"@zh ; skos:notation "observation" .
pdksv:opinion a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "观点"@zh ; skos:notation "opinion" .
pdksv:hypothesis a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "假设表达"@zh ; skos:notation "hypothesis" .
pdksv:intention a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "意图"@zh ; skos:notation "intention" .
pdksv:commitment a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "承诺表达"@zh ; skos:notation "commitment" .
pdksv:decision a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "决策"@zh ; skos:notation "decision" .
pdksv:question a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "问题"@zh ; skos:notation "question" .
pdksv:estimate a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "估计"@zh ; skos:notation "estimate" .
pdksv:preference a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "偏好"@zh ; skos:notation "preference" .

# Context types
pdksv:ContextTypes a skos:Collection ;
  skos:prefLabel "个人上下文类型"@zh ;
  skos:member pdksv:role, pdksv:goal, pdksv:capability, pdksv:responsibility, pdksv:working_style, pdksv:current_focus, pdksv:constraint, pdksv:relationship_context, pdksv:preference_context .
pdksv:role a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "角色"@zh ; skos:notation "role" .
pdksv:goal a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "目标"@zh ; skos:notation "goal" .
pdksv:capability a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "能力"@zh ; skos:notation "capability" .
pdksv:responsibility a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "责任"@zh ; skos:notation "responsibility" .
pdksv:working_style a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "工作方式"@zh ; skos:notation "working_style" .
pdksv:current_focus a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "当前关注"@zh ; skos:notation "current_focus" .
pdksv:constraint a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "约束条件"@zh ; skos:notation "constraint" .
pdksv:relationship_context a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "关系上下文"@zh ; skos:notation "relationship" .
pdksv:preference_context a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "偏好"@zh ; skos:notation "preference" .

# Sensitivity and access scopes
pdksv:SensitivityLevels a skos:Collection ;
  skos:prefLabel "敏感级别"@zh ;
  skos:member pdksv:personal_private, pdksv:personal_work, pdksv:organization_internal, pdksv:restricted, pdksv:public .
pdksv:personal_private a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "个人私密"@zh ; skos:notation "personal_private" .
pdksv:personal_work a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "个人工作"@zh ; skos:notation "personal_work" .
pdksv:organization_internal a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "组织内部"@zh ; skos:notation "organization_internal" .
pdksv:restricted a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "受限"@zh ; skos:notation "restricted" .
pdksv:public a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "公开"@zh ; skos:notation "public" .

pdksv:AccessScopes a skos:Collection ;
  skos:prefLabel "访问范围"@zh ;
  skos:member pdksv:owner_only, pdksv:explicitly_shared, pdksv:organization_authorized, pdksv:public_access .
pdksv:owner_only a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "仅本人"@zh ; skos:notation "owner_only" .
pdksv:explicitly_shared a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "明确共享"@zh ; skos:notation "explicitly_shared" .
pdksv:organization_authorized a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "组织授权范围"@zh ; skos:notation "organization_authorized" .
pdksv:public_access a skos:Concept ; skos:inScheme pdksv:CoreVocabularies ; skos:prefLabel "公开访问"@zh ; skos:notation "public" .
