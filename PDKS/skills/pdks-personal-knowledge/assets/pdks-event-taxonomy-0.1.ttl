@prefix pdks: <urn:pdks:ontology:0.1#> .
@prefix pdtax: <urn:pdks:taxonomy:event:0.1#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pdtax:EventTypes a skos:ConceptScheme ;
  skos:prefLabel "PDKS 个人事件分类词表 0.1"@zh ;
  skos:definition "用于描述个人工作、学习、思考、生活等场景中发生的事件类型。"@zh ;
  skos:notation "0.1.0" .

