@prefix pdks: <urn:pdks:ontology#> .
@prefix pdksv: <urn:pdks:vocabulary:0.2#> .
@prefix pdtax: <urn:pdks:taxonomy:event:0.1#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Every PDKS record has exactly one owner and explicit governance classifications.
pdks:PersonalDataRecordShape a sh:NodeShape ;
  sh:targetClass pdks:PersonalDataRecord ;
  sh:property [ sh:path pdks:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "每条个人数据记录必须且只能有一个 owner。"@zh ] ;
  sh:property [ sh:path pdks:hasSensitivity ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:message "每条记录必须且只能有一个敏感级别。"@zh ] ;
  sh:property [ sh:path pdks:hasAccessScope ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:message "每条记录必须且只能有一个访问范围。"@zh ] ;
  sh:sparql [
    sh:message "记录引用了其他 owner 的个人数据记录；跨 owner 关系必须经过显式授权投影。"@zh ;
    sh:select """
      PREFIX pdks: <urn:pdks:ontology#>
      SELECT $this ?other WHERE {
        $this pdks:ownedBy ?owner ; ?predicate ?other .
        ?other a pdks:PersonalDataRecord ; pdks:ownedBy ?otherOwner .
        FILTER (?owner != ?otherOwner)
      }
    """
  ] .

pdks:EventShape a sh:NodeShape ;
  sh:targetClass pdks:Event ;
  sh:property [ sh:path pdks:hasEventType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:message "事件必须且只能有一个事件类型概念。"@zh ] ;
  sh:property [ sh:path pdks:description ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "事件必须保留描述。"@zh ] ;
  sh:property [ sh:path pdks:occurredDuring ; sh:maxCount 1 ; sh:class time:Interval ] ;
  sh:sparql [
    sh:message "事件类型必须来自受控 Event Taxonomy。"@zh ;
    sh:select """
      PREFIX pdks: <urn:pdks:ontology#>
      PREFIX pdtax: <urn:pdks:taxonomy:event:0.1#>
      PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
      SELECT $this WHERE {
        $this pdks:hasEventType ?eventType .
        FILTER NOT EXISTS { ?eventType skos:inScheme pdtax:EventTypes . }
      }
    """
  ] .

pdks:AssertionShape a sh:NodeShape ;
  sh:targetClass pdks:Assertion ;
  sh:property [ sh:path pdks:content ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path pdks:assertedBy ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path pdks:hasEpistemicStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ] ;
  sh:sparql [
    sh:message "Assertion 的认知状态必须来自 PDKS 核心受控词汇。"@zh ;
    sh:select """
      PREFIX pdks: <urn:pdks:ontology#>
      PREFIX pdksv: <urn:pdks:vocabulary:0.2#>
      PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
      SELECT $this WHERE {
        $this pdks:hasEpistemicStatus ?status .
        FILTER NOT EXISTS { ?status skos:inScheme <urn:pdks:vocabulary:0.2> . }
      }
    """
  ] .

pdks:EvidenceSegmentShape a sh:NodeShape ;
  sh:targetClass pdks:EvidenceSegment ;
  sh:property [ sh:path pdks:extractedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pdks:SourceAsset ] .

pdks:PersonalContextShape a sh:NodeShape ;
  sh:targetClass pdks:PersonalContextStatement ;
  sh:property [ sh:path pdks:hasSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pdks:Person ] ;
  sh:property [ sh:path pdks:hasContextType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ] ;
  sh:property [ sh:path pdks:verificationStatus ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:sparql [
    sh:message "个人上下文类型必须来自 PDKS 核心受控词汇。"@zh ;
    sh:select """
      PREFIX pdks: <urn:pdks:ontology#>
      PREFIX pdksv: <urn:pdks:vocabulary:0.2#>
      PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
      SELECT $this WHERE {
        $this pdks:hasContextType ?contextType .
        FILTER NOT EXISTS { ?contextType skos:inScheme <urn:pdks:vocabulary:0.2> . }
      }
    """
  ] .

pdks:ActionSpecificationShape a sh:NodeShape ;
  sh:targetClass pdks:ActionSpecification ;
  sh:property [ sh:path pdks:title ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:sparql [
    sh:message "人的 ActionSpecification 不得同时被标记为 AgentActionProposal。"@zh ;
    sh:select """
      PREFIX pdks: <urn:pdks:ontology#>
      SELECT $this WHERE { $this a pdks:AgentActionProposal . }
    """
  ] .

pdks:AgentActionProposalShape a sh:NodeShape ;
  sh:targetClass pdks:AgentActionProposal ;
  sh:property [ sh:path pdks:proposedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pdks:SoftwareAgent ] ;
  sh:property [ sh:path pdks:requiresApproval ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path pdks:approvalStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:sparql [
    sh:message "已批准或已执行的 Agent 动作必须保留批准人。"@zh ;
    sh:select """
      PREFIX pdks: <urn:pdks:ontology#>
      SELECT $this WHERE {
        $this pdks:approvalStatus ?status .
        FILTER (?status IN ("approved", "executed"))
        FILTER NOT EXISTS { $this pdks:approvedBy ?approver . }
      }
    """
  ] ;
  sh:sparql [
    sh:message "已执行的 Agent 动作必须保留执行主体。"@zh ;
    sh:select """
      PREFIX pdks: <urn:pdks:ontology#>
      SELECT $this WHERE {
        $this pdks:executionStatus "executed" .
        FILTER NOT EXISTS { $this pdks:executedBy ?agent . }
      }
    """
  ] .

pdks:SourceAssetShape a sh:NodeShape ;
  sh:targetClass pdks:SourceAsset ;
  sh:property [ sh:path pdks:sourceLocator ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:sparql [
    sh:message "设备采集或连接器同步的来源必须关联授权记录。"@zh ;
    sh:select """
      PREFIX pdks: <urn:pdks:ontology#>
      SELECT $this WHERE {
        $this pdks:captureMethod ?method .
        FILTER (?method IN ("device_capture", "connector_sync"))
        FILTER NOT EXISTS { $this pdks:hasConsent ?consent . }
      }
    """
  ] .

pdks:QualifiedRelationshipShape a sh:NodeShape ;
  sh:targetClass pdks:QualifiedRelationship ;
  sh:property [ sh:path pdks:relationshipSubject ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path pdks:relationshipObject ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path pdks:relationshipPredicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ] ;
  sh:property [ sh:path pdks:relationshipPredicateCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "derived_from" "supports" "contradicts" "related_to" "part_of" "depends_on" "participated_in" ) ] .
