@prefix pdksv: <urn:pdks:vocabulary:0.2#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:pdks:vocabulary:0.2> a skos:ConceptScheme ; skos:prefLabel "PDKS 核心受控词汇 0.2"@zh ; dcterms:title "PDKS Controlled Vocabulary 0.2"@en ; skos:notation "0.2.0" .

pdksv:Domain a skos:Collection ; skos:prefLabel "Domain"@en, "Domain"@zh ; skos:member pdksv:work, pdksv:learning, pdksv:thinking, pdksv:life, pdksv:relationship, pdksv:growth, pdksv:finance, pdksv:health, pdksv:other .
pdksv:work a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "work" ; skos:prefLabel "工作"@zh, "Work"@en .
pdksv:learning a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "learning" ; skos:prefLabel "学习"@zh, "Learning"@en .
pdksv:thinking a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "thinking" ; skos:prefLabel "思考"@zh, "Thinking"@en .
pdksv:life a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "life" ; skos:prefLabel "生活"@zh, "Life"@en .
pdksv:relationship a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "relationship" ; skos:prefLabel "关系"@zh, "Relationship"@en .
pdksv:growth a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "growth" ; skos:prefLabel "成长"@zh, "Growth"@en .
pdksv:finance a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "finance" ; skos:prefLabel "财务"@zh, "Finance"@en .
pdksv:health a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "health" ; skos:prefLabel "健康"@zh, "Health"@en .
pdksv:other a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "other" ; skos:prefLabel "其他"@zh, "Other"@en .

pdksv:EpistemicStatus a skos:Collection ; skos:prefLabel "EpistemicStatus"@en, "EpistemicStatus"@zh ; skos:member pdksv:reported, pdksv:inferred, pdksv:hypothesized, pdksv:corroborated, pdksv:disputed, pdksv:retracted, pdksv:unknown .
pdksv:reported a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "reported" ; skos:prefLabel "来源报告"@zh, "Reported"@en .
pdksv:inferred a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "inferred" ; skos:prefLabel "系统推断"@zh, "Inferred"@en .
pdksv:hypothesized a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "hypothesized" ; skos:prefLabel "假设"@zh, "Hypothesized"@en .
pdksv:corroborated a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "corroborated" ; skos:prefLabel "多方印证"@zh, "Corroborated"@en .
pdksv:disputed a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "disputed" ; skos:prefLabel "存在争议"@zh, "Disputed"@en .
pdksv:retracted a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "retracted" ; skos:prefLabel "已撤回"@zh, "Retracted"@en .
pdksv:unknown a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "unknown" ; skos:prefLabel "未知"@zh, "Unknown"@en .

pdksv:AssertionType a skos:Collection ; skos:prefLabel "AssertionType"@en, "AssertionType"@zh ; skos:member pdksv:observation, pdksv:opinion, pdksv:hypothesis, pdksv:intention, pdksv:commitment, pdksv:decision, pdksv:question, pdksv:estimate, pdksv:preference .
pdksv:observation a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "observation" ; skos:prefLabel "观察"@zh, "Observation"@en .
pdksv:opinion a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "opinion" ; skos:prefLabel "观点"@zh, "Opinion"@en .
pdksv:hypothesis a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "hypothesis" ; skos:prefLabel "假设表达"@zh, "Hypothesis"@en .
pdksv:intention a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "intention" ; skos:prefLabel "意图"@zh, "Intention"@en .
pdksv:commitment a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "commitment" ; skos:prefLabel "承诺表达"@zh, "Commitment"@en .
pdksv:decision a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "decision" ; skos:prefLabel "决策"@zh, "Decision"@en .
pdksv:question a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "question" ; skos:prefLabel "问题"@zh, "Question"@en .
pdksv:estimate a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "estimate" ; skos:prefLabel "估计"@zh, "Estimate"@en .
pdksv:preference a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "preference" ; skos:prefLabel "偏好"@zh, "Preference"@en .

pdksv:ContextType a skos:Collection ; skos:prefLabel "ContextType"@en, "ContextType"@zh ; skos:member pdksv:role, pdksv:goal, pdksv:capability, pdksv:responsibility, pdksv:working_style, pdksv:current_focus, pdksv:constraint, pdksv:relationship_context, pdksv:preference_context .
pdksv:role a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "role" ; skos:prefLabel "角色"@zh, "Role"@en .
pdksv:goal a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "goal" ; skos:prefLabel "目标"@zh, "Goal"@en .
pdksv:capability a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "capability" ; skos:prefLabel "能力"@zh, "Capability"@en .
pdksv:responsibility a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "responsibility" ; skos:prefLabel "责任"@zh, "Responsibility"@en .
