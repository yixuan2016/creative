pdksv:constraint a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "constraint" ; skos:prefLabel "约束"@zh, "Constraint"@en .
pdksv:relationship_context a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "relationship_context" ; skos:prefLabel "关系上下文"@zh, "Relationship Context"@en .
pdksv:preference_context a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "preference_context" ; skos:prefLabel "偏好上下文"@zh, "Preference Context"@en .

pdksv:Sensitivity a skos:Collection ; skos:prefLabel "Sensitivity"@en, "Sensitivity"@zh ; skos:member pdksv:personal_private, pdksv:personal_work, pdksv:organization_internal, pdksv:restricted, pdksv:public .
pdksv:personal_private a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "personal_private" ; skos:prefLabel "个人私密"@zh, "Personal Private"@en .
pdksv:personal_work a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "personal_work" ; skos:prefLabel "个人工作"@zh, "Personal Work"@en .
pdksv:organization_internal a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "organization_internal" ; skos:prefLabel "组织内部"@zh, "Organization Internal"@en .
pdksv:restricted a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "restricted" ; skos:prefLabel "受限"@zh, "Restricted"@en .
pdksv:public a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "public" ; skos:prefLabel "公开"@zh, "Public"@en .

pdksv:AccessScope a skos:Collection ; skos:prefLabel "AccessScope"@en, "AccessScope"@zh ; skos:member pdksv:owner_only, pdksv:explicitly_shared, pdksv:organization_authorized, pdksv:public .
pdksv:owner_only a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "owner_only" ; skos:prefLabel "仅本人"@zh, "Owner Only"@en .
pdksv:explicitly_shared a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "explicitly_shared" ; skos:prefLabel "明确共享"@zh, "Explicitly Shared"@en .
pdksv:organization_authorized a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "organization_authorized" ; skos:prefLabel "组织授权"@zh, "Organization Authorized"@en .
pdksv:public a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "public" ; skos:prefLabel "公开"@zh, "Public"@en .

pdksv:LifecycleStatus a skos:Collection ; skos:prefLabel "LifecycleStatus"@en, "LifecycleStatus"@zh ; skos:member pdksv:active, pdksv:archived, pdksv:superseded, pdksv:retracted, pdksv:deleted_tombstone, pdksv:unresolved .
pdksv:active a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "active" ; skos:prefLabel "有效"@zh, "Active"@en .
pdksv:archived a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "archived" ; skos:prefLabel "已归档"@zh, "Archived"@en .
