pdksv:retracted a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "retracted" ; skos:prefLabel "已撤回"@zh, "Retracted"@en .
pdksv:deleted_tombstone a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "deleted_tombstone" ; skos:prefLabel "删除墓碑"@zh, "Deleted Tombstone"@en .
pdksv:unresolved a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "unresolved" ; skos:prefLabel "待解决"@zh, "Unresolved"@en .

pdksv:VerificationStatus a skos:Collection ; skos:prefLabel "VerificationStatus"@en, "VerificationStatus"@zh ; skos:member pdksv:owner_confirmed, pdksv:source_reported, pdksv:inferred, pdksv:under_review, pdksv:rejected .
pdksv:owner_confirmed a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "owner_confirmed" ; skos:prefLabel "本人确认"@zh, "Owner Confirmed"@en .
pdksv:source_reported a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "source_reported" ; skos:prefLabel "来源陈述"@zh, "Source Reported"@en .
pdksv:inferred a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "inferred" ; skos:prefLabel "系统推断"@zh, "Inferred"@en .
pdksv:under_review a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "under_review" ; skos:prefLabel "待复核"@zh, "Under Review"@en .
pdksv:rejected a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "rejected" ; skos:prefLabel "已拒绝"@zh, "Rejected"@en .

pdksv:ActionStatus a skos:Collection ; skos:prefLabel "ActionStatus"@en, "ActionStatus"@zh ; skos:member pdksv:open, pdksv:in_progress, pdksv:completed, pdksv:cancelled, pdksv:blocked, pdksv:deferred .
pdksv:open a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "open" ; skos:prefLabel "待处理"@zh, "Open"@en .
pdksv:in_progress a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "in_progress" ; skos:prefLabel "进行中"@zh, "In Progress"@en .
pdksv:completed a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "completed" ; skos:prefLabel "已完成"@zh, "Completed"@en .
pdksv:cancelled a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "cancelled" ; skos:prefLabel "已取消"@zh, "Cancelled"@en .
pdksv:blocked a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "blocked" ; skos:prefLabel "受阻"@zh, "Blocked"@en .
pdksv:deferred a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "deferred" ; skos:prefLabel "已延期"@zh, "Deferred"@en .

pdksv:RelationshipStatus a skos:Collection ; skos:prefLabel "RelationshipStatus"@en, "RelationshipStatus"@zh ; skos:member pdksv:proposed, pdksv:confirmed, pdksv:disputed, pdksv:retracted .
pdksv:proposed a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "proposed" ; skos:prefLabel "待确认"@zh, "Proposed"@en .
pdksv:confirmed a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "confirmed" ; skos:prefLabel "已确认"@zh, "Confirmed"@en .
pdksv:disputed a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "disputed" ; skos:prefLabel "存在争议"@zh, "Disputed"@en .
pdksv:retracted a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "retracted" ; skos:prefLabel "已撤回"@zh, "Retracted"@en .


pdksv:RelationshipPredicate a skos:Collection ; skos:prefLabel "关系谓词"@zh ; skos:member pdksv:derived_from, pdksv:supports, pdksv:contradicts, pdksv:related_to, pdksv:part_of, pdksv:depends_on, pdksv:participated_in .
pdksv:derived_from a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "derived_from" ; skos:prefLabel "推导自"@zh, "Derived From"@en .
pdksv:supports a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "supports" ; skos:prefLabel "支持"@zh, "Supports"@en .
pdksv:contradicts a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "contradicts" ; skos:prefLabel "反驳"@zh, "Contradicts"@en .
pdksv:related_to a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "related_to" ; skos:prefLabel "相关"@zh, "Related To"@en .
pdksv:part_of a skos:Concept ; skos:inScheme <urn:pdks:vocabulary:0.2> ; skos:notation "part_of" ; skos:prefLabel "属于"@zh, "Part Of"@en .
