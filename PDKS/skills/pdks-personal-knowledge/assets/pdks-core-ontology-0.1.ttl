@prefix pdks: <urn:pdks:ontology:0.1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:pdks:ontology:0.1> a owl:Ontology ;
  dcterms:title "PDKS Core Ontology 0.1"@en, "PDKS 核心本体 0.1"@zh ;
  dcterms:description "Provisional semantic model for personal digital knowledge data."@en ;
  owl:versionInfo "0.1.0" ;
  owl:imports <http://www.w3.org/ns/prov#>, <http://www.w3.org/2004/02/skos/core#>, <http://www.w3.org/2006/time#> .

# ---- Agents and domain entities ----
pdks:Agent a owl:Class ;
  rdfs:subClassOf prov:Agent ;
  rdfs:label "Agent"@en, "行动主体"@zh ;
  rdfs:comment "A person, organization, or software agent that acts, speaks, creates, or is responsible."@en .

pdks:Person a owl:Class ;
  rdfs:subClassOf pdks:Agent, prov:Person ;
  rdfs:label "Person"@en, "个人"@zh .

pdks:Organization a owl:Class ;
  rdfs:subClassOf pdks:Agent, prov:Organization ;
  rdfs:label "Organization"@en, "组织"@zh .

pdks:SoftwareAgent a owl:Class ;
  rdfs:subClassOf pdks:Agent, prov:SoftwareAgent ;
  rdfs:label "Software Agent"@en, "软件智能体"@zh .

pdks:DomainEntity a owl:Class ;
  rdfs:label "Domain Entity"@en, "领域实体"@zh ;
  rdfs:comment "A thing referred to in personal records, such as a project, place, topic, tool, or goal."@en .

pdks:Project a owl:Class ; rdfs:subClassOf pdks:DomainEntity ; rdfs:label "Project"@en, "项目"@zh .
pdks:Place a owl:Class ; rdfs:subClassOf pdks:DomainEntity ; rdfs:label "Place"@en, "地点"@zh .
pdks:Topic a owl:Class ; rdfs:subClassOf pdks:DomainEntity ; rdfs:label "Topic"@en, "主题"@zh .
pdks:Tool a owl:Class ; rdfs:subClassOf pdks:DomainEntity ; rdfs:label "Tool"@en, "工具"@zh .
pdks:Goal a owl:Class ; rdfs:subClassOf pdks:DomainEntity ; rdfs:label "Goal"@en, "目标"@zh .

# ---- Occurrences and activities ----
pdks:Event a owl:Class ;
  rdfs:label "Event"@en, "事件"@zh ;
  rdfs:comment "An occurrence in a person's work or life timeline. Event types are SKOS concepts, not necessarily separate OWL classes."@en .

pdks:ActivityEvent a owl:Class ;
  rdfs:subClassOf pdks:Event, prov:Activity ;
  rdfs:label "Activity Event"@en, "活动型事件"@zh ;
  rdfs:comment "An event that is an activity carried out by one or more agents."@en .

pdks:ProcessingActivity a owl:Class ;
  rdfs:subClassOf prov:Activity ;
  rdfs:label "Processing Activity"@en, "数据处理活动"@zh ;
  rdfs:comment "A system or AI operation such as capture, transcription, extraction, classification, summarization, or migration."@en .

# ---- Information objects ----
pdks:InformationObject a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Information Object"@en, "信息对象"@zh .

pdks:SourceAsset a owl:Class ;
  rdfs:subClassOf pdks:InformationObject ;
  rdfs:label "Source Asset"@en, "原始材料"@zh .

pdks:EvidenceSegment a owl:Class ;
  rdfs:subClassOf pdks:InformationObject ;
  rdfs:label "Evidence Segment"@en, "证据片段"@zh ;
  rdfs:comment "A locatable segment of a source asset, such as a message, paragraph, transcript span, or audio interval."@en .

pdks:Assertion a owl:Class ;
  rdfs:subClassOf pdks:InformationObject ;
  rdfs:label "Assertion"@en, "主张/表达"@zh ;
  rdfs:comment "A statement made by an agent or inferred by a system; it must retain who asserted it, epistemic status, and supporting evidence where available."@en .

pdks:KnowledgeAsset a owl:Class ;
  rdfs:subClassOf pdks:InformationObject ;
  rdfs:label "Knowledge Asset"@en, "知识资产"@zh ;
  rdfs:comment "A reusable concept, method, experience, case, principle, lesson, or insight derived from records and evidence."@en .

pdks:PersonalContextStatement a owl:Class ;
  rdfs:subClassOf pdks:InformationObject ;
  rdfs:label "Personal Context Statement"@en, "个人上下文陈述"@zh ;
  rdfs:comment "A time-qualified, evidence-aware statement about a person's role, goal, preference, capability, responsibility, or current focus. It is not automatically an unquestionable fact."@en .

pdks:ActionSpecification a owl:Class ;
  rdfs:subClassOf pdks:InformationObject ;
  rdfs:label "Action Specification"@en, "行动计划项"@zh ;
  rdfs:comment "A planned or committed action, distinct from an event that has actually happened."@en .

pdks:Task a owl:Class ; rdfs:subClassOf pdks:ActionSpecification ; rdfs:label "Task"@en, "任务"@zh .
pdks:Plan a owl:Class ; rdfs:subClassOf pdks:ActionSpecification ; rdfs:label "Plan"@en, "计划"@zh .
pdks:Commitment a owl:Class ; rdfs:subClassOf pdks:ActionSpecification ; rdfs:label "Commitment"@en, "承诺"@zh .
pdks:Reminder a owl:Class ; rdfs:subClassOf pdks:ActionSpecification ; rdfs:label "Reminder"@en, "提醒"@zh .

pdks:QualifiedRelationship a owl:Class ;
  rdfs:subClassOf pdks:InformationObject ;
  rdfs:label "Qualified Relationship"@en, "带证据的关系记录"@zh ;
  rdfs:comment "A reified relationship record used when a relationship needs its own source, status, confidence, validity period, or reviewer. Simple relationships may be represented directly as RDF edges."@en .

pdks:RoleAssignment a owl:Class ;
  rdfs:subClassOf pdks:InformationObject ;
  rdfs:label "Role Assignment"@en, "角色任职/承担记录"@zh ;
  rdfs:comment "A time-bounded assignment of a role to a person or agent in an organization, project, or context."@en .

# ---- Core semantic properties ----
pdks:hasEventType a owl:ObjectProperty ;
  rdfs:domain pdks:Event ; rdfs:range skos:Concept ;
  rdfs:label "has event type"@en, "事件类型"@zh .

pdks:occurredDuring a owl:ObjectProperty ;
  rdfs:domain pdks:Event ; rdfs:range time:TemporalEntity ;
  rdfs:label "occurred during"@en, "发生于时间段"@zh ;
  rdfs:comment "Links an event to its temporal interval or instant; unknown or imprecise time must remain explicit in the record layer."@en .

pdks:hasParticipant a owl:ObjectProperty ;
  rdfs:domain pdks:Event ; rdfs:range pdks:Agent ;
  owl:inverseOf pdks:participatedIn ;
  rdfs:label "has participant"@en, "参与者"@zh .

pdks:participatedIn a owl:ObjectProperty ;
  rdfs:domain pdks:Agent ; rdfs:range pdks:Event ;
  rdfs:label "participated in"@en, "参与了"@zh .

pdks:hasContextEntity a owl:ObjectProperty ;
  rdfs:domain pdks:Event ; rdfs:range pdks:DomainEntity ;
  rdfs:label "has context entity"@en, "关联领域实体"@zh .

pdks:hasDomain a owl:ObjectProperty ;
  rdfs:range skos:Concept ;
  rdfs:label "has domain"@en, "所属领域"@zh .

pdks:ownedBy a owl:ObjectProperty ;
  rdfs:range pdks:Agent ;
  rdfs:label "owned by"@en, "数据归属主体"@zh .

pdks:hasRoleAssignment a owl:ObjectProperty ;
  rdfs:domain pdks:Agent ; rdfs:range pdks:RoleAssignment ;
  rdfs:label "has role assignment"@en, "具有角色承担记录"@zh .

pdks:about a owl:ObjectProperty ;
  rdfs:domain pdks:InformationObject ; rdfs:range owl:Thing ;
  rdfs:label "about"@en, "涉及/关于"@zh .

pdks:hasEvidence a owl:ObjectProperty ;
  rdfs:domain owl:Thing ; rdfs:range pdks:EvidenceSegment ;
  rdfs:label "has evidence"@en, "有证据片段"@zh .

pdks:extractedFrom a owl:ObjectProperty ;
  rdfs:subPropertyOf prov:wasDerivedFrom ;
  rdfs:domain pdks:EvidenceSegment ; rdfs:range pdks:SourceAsset ;
  rdfs:label "extracted from"@en, "提取自"@zh .

pdks:derivedFrom a owl:ObjectProperty ;
  rdfs:subPropertyOf prov:wasDerivedFrom ;
  rdfs:domain pdks:InformationObject ; rdfs:range prov:Entity ;
  rdfs:label "derived from"@en, "来源推导自"@zh .

pdks:generatedBy a owl:ObjectProperty ;
  rdfs:subPropertyOf prov:wasGeneratedBy ;
  rdfs:domain pdks:InformationObject ; rdfs:range pdks:ProcessingActivity ;
  rdfs:label "generated by"@en, "由处理活动生成"@zh .

pdks:attributedTo a owl:ObjectProperty ;
  rdfs:subPropertyOf prov:wasAttributedTo ;
  rdfs:domain pdks:InformationObject ; rdfs:range pdks:Agent ;
  rdfs:label "attributed to"@en, "归属于/由其负责"@zh .

pdks:assertedBy a owl:ObjectProperty ;
  rdfs:domain pdks:Assertion ; rdfs:range pdks:Agent ;
  rdfs:label "asserted by"@en, "表达者/主张者"@zh .

pdks:hasEpistemicStatus a owl:ObjectProperty ;
  rdfs:domain pdks:Assertion ; rdfs:range skos:Concept ;
  rdfs:label "has epistemic status"@en, "认知状态"@zh .

pdks:hasAssertionType a owl:ObjectProperty ;
  rdfs:domain pdks:Assertion ; rdfs:range skos:Concept ;
  rdfs:label "has assertion type"@en, "表达类型"@zh .

pdks:hasOutcome a owl:ObjectProperty ;
  rdfs:domain pdks:Event ; rdfs:range pdks:InformationObject ;
  rdfs:label "has outcome"@en, "产生结果"@zh .

pdks:realizesAction a owl:ObjectProperty ;
  rdfs:domain pdks:Event ; rdfs:range pdks:ActionSpecification ;
  rdfs:label "realizes action"@en, "落实了行动项"@zh .

pdks:assignedTo a owl:ObjectProperty ;
  rdfs:domain pdks:ActionSpecification ; rdfs:range pdks:Agent ;
  rdfs:label "assigned to"@en, "分配给"@zh .

pdks:hasDueTime a owl:ObjectProperty ;
  rdfs:domain pdks:ActionSpecification ; rdfs:range time:TemporalEntity ;
  rdfs:label "has due time"@en, "截止时间"@zh .

pdks:hasSubject a owl:ObjectProperty ;
  rdfs:domain pdks:PersonalContextStatement ; rdfs:range pdks:Person ;
  rdfs:label "has subject person"@en, "描述的个人"@zh .

pdks:hasContextType a owl:ObjectProperty ;
  rdfs:domain pdks:PersonalContextStatement ; rdfs:range skos:Concept ;
  rdfs:label "has context type"@en, "上下文类型"@zh .

pdks:validDuring a owl:ObjectProperty ;
  rdfs:domain pdks:InformationObject ; rdfs:range time:TemporalEntity ;
  rdfs:label "valid during"@en, "在此期间有效"@zh .

pdks:hasRoleHolder a owl:ObjectProperty ;
  rdfs:domain pdks:RoleAssignment ; rdfs:range pdks:Agent ;
  rdfs:label "has role holder"@en, "角色承担者"@zh .

pdks:hasRoleType a owl:ObjectProperty ;
  rdfs:domain pdks:RoleAssignment ; rdfs:range skos:Concept ;
  rdfs:label "has role type"@en, "角色类型"@zh .

pdks:hasRoleContext a owl:ObjectProperty ;
  rdfs:domain pdks:RoleAssignment ; rdfs:range pdks:DomainEntity ;
  rdfs:label "has role context"@en, "角色所属场景"@zh .

pdks:possibleIdentityMatch a owl:ObjectProperty ;
  rdfs:domain owl:Thing ; rdfs:range owl:Thing ;
  rdfs:label "possible identity match"@en, "可能是同一对象"@zh ;
  rdfs:comment "A cautious identity-resolution link; do not replace with owl:sameAs until identity is confirmed."@en .

pdks:mergedInto a owl:ObjectProperty ;
  rdfs:domain owl:Thing ; rdfs:range owl:Thing ;
  rdfs:label "merged into"@en, "合并到"@zh .

# ---- Data properties ----
pdks:canonicalName a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "canonical name"@en, "标准名称"@zh .
pdks:title a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "title"@en, "标题"@zh .
pdks:description a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "description"@en, "描述"@zh .
pdks:content a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "content"@en, "内容"@zh .
pdks:sourceLocator a owl:DatatypeProperty ; rdfs:domain pdks:SourceAsset ; rdfs:range xsd:string ; rdfs:label "source locator"@en, "原始材料定位符"@zh .
pdks:timePrecision a owl:DatatypeProperty ; rdfs:domain pdks:Event ; rdfs:range xsd:string ; rdfs:label "time precision"@en, "时间精度"@zh .
pdks:confidenceLevel a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "confidence level"@en, "置信等级"@zh .
pdks:verificationStatus a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "verification status"@en, "核验状态"@zh .
pdks:recordedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTimeStamp ; rdfs:label "recorded at"@en, "记录时间"@zh .
pdks:capturedAt a owl:DatatypeProperty ; rdfs:domain pdks:SourceAsset ; rdfs:range xsd:dateTimeStamp ; rdfs:label "captured at"@en, "采集时间"@zh .
pdks:hasSensitivity a owl:ObjectProperty ; rdfs:range skos:Concept ; rdfs:label "has sensitivity"@en, "敏感级别"@zh .
pdks:hasAccessScope a owl:ObjectProperty ; rdfs:range skos:Concept ; rdfs:label "has access scope"@en, "访问范围"@zh .

# ---- Qualified relationship fields ----
pdks:relationshipSubject a owl:ObjectProperty ; rdfs:domain pdks:QualifiedRelationship ; rdfs:label "relationship subject"@en, "关系主体"@zh .
pdks:relationshipObject a owl:ObjectProperty ; rdfs:domain pdks:QualifiedRelationship ; rdfs:label "relationship object"@en, "关系客体"@zh .
pdks:relationshipPredicate a owl:ObjectProperty ; rdfs:domain pdks:QualifiedRelationship ; rdfs:range skos:Concept ; rdfs:label "relationship predicate"@en, "关系类型"@zh .
pdks:relationshipStatus a owl:DatatypeProperty ; rdfs:domain pdks:QualifiedRelationship ; rdfs:range xsd:string ; rdfs:label "relationship status"@en, "关系状态"@zh .
