@prefix pdks: <urn:pdks:ontology:0.1#> .
@prefix pdtax: <urn:pdks:taxonomy:event:0.1#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

pdks:EventShape a sh:NodeShape ;
  sh:targetClass pdks:Event ;
  sh:property [
    sh:path pdks:hasEventType ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class skos:Concept ;
    sh:message "事件必须且只能有一个主要事件类型概念。"@zh
  ] ;
  sh:property [
    sh:path pdks:description ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "事件必须保留发生内容的描述。"@zh
  ] ;
  sh:property [
    sh:path pdks:occurredDuring ;
    sh:maxCount 1 ;
    sh:class time:TemporalEntity ;
    sh:message "事件时间应关联时间点或时间段；未知时间应在记录层明确标记。"@zh
  ] .

pdks:AssertionShape a sh:NodeShape ;
  sh:targetClass pdks:Assertion ;
  sh:property [
    sh:path pdks:content ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "主张必须有内容。"@zh
  ] ;
  sh:property [
    sh:path pdks:assertedBy ;
    sh:minCount 1 ;
    sh:class pdks:Agent ;
    sh:message "主张必须说明表达者或生成者。"@zh
  ] ;
  sh:property [
    sh:path pdks:hasEpistemicStatus ;
    sh:minCount 1 ;
    sh:class skos:Concept ;
    sh:message "主张必须标注认知状态，例如 reported 或 inferred。"@zh
  ] .

pdks:EvidenceSegmentShape a sh:NodeShape ;
  sh:targetClass pdks:EvidenceSegment ;
  sh:property [
    sh:path pdks:extractedFrom ;
    sh:minCount 1 ;
    sh:class pdks:SourceAsset ;
    sh:message "证据片段必须能够追溯到原始材料。"@zh
  ] .

pdks:PersonalContextShape a sh:NodeShape ;
  sh:targetClass pdks:PersonalContextStatement ;
  sh:property [
    sh:path pdks:hasSubject ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class pdks:Person ;
    sh:message "个人上下文必须指明被描述的个人。"@zh
  ] ;
  sh:property [
    sh:path pdks:verificationStatus ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "个人上下文必须说明是本人声明、已确认还是 AI 推断。"@zh
  ] .

pdks:ActionShape a sh:NodeShape ;
  sh:targetClass pdks:ActionSpecification ;
  sh:property [
    sh:path pdks:title ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "行动项必须有标题。"@zh
  ] ;
  sh:property [
    sh:path pdks:assignedTo ;
    sh:maxCount 1 ;
    sh:class pdks:Agent ;
    sh:message "行动责任人如已指定，应引用有效主体。"@zh
  ] .

pdks:RoleAssignmentShape a sh:NodeShape ;
  sh:targetClass pdks:RoleAssignment ;
  sh:property [
    sh:path pdks:hasRoleHolder ;
    sh:minCount 1 ;
    sh:class pdks:Agent ;
    sh:message "角色承担记录必须指明承担者。"@zh
  ] ;
  sh:property [
    sh:path pdks:hasRoleType ;
    sh:minCount 1 ;
    sh:class skos:Concept ;
    sh:message "角色承担记录必须指明角色类型。"@zh
  ] .
